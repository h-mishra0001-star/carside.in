{
  "name": "carside-backend",
  "version": "1.0.0",
  "description": "Carside.in Backend API - Node.js + Express + MongoDB",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:debug": "nodemon --inspect server.js",
    "prod": "NODE_ENV=production node server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "seed": "node scripts/seedData.js",
    "seed:reset": "node scripts/seedData.js --reset",
    "seed:brands": "node scripts/seedBrands.js",
    "seed:cars": "node scripts/seedCars.js",
    "fix:cars": "node scripts/fixCarData.js",
    "db:check": "node scripts/checkDatabase.js",
    "db:stats": "node scripts/dbStats.js",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "lint": "echo \"Add linter configuration\"",
    "format": "echo \"Add formatter configuration\""
  },
  "keywords": [
    "cars",
    "automotive",
    "api",
    "express",
    "mongodb",
    "nodejs",
    "craigslist",
    "vehicles"
  ],
  "author": "Carside.in",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "nodemonConfig": {
    "ignore": [
      "node_modules",
      "data/",
      "uploads/",
      "logs/"
    ],
    "watch": [
      "server.js",
      "config/",
      "models/",
      "routes/",
      "controllers/",
      "middleware/",
      "utils/",
      "scripts/"
    ],
    "ext": "js,json",
    "delay": 1000,
    "env": {
      "NODE_ENV": "development"
    }
  }
}